{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wckd-gpu",
  "version": "0.1.0",
  "identifier": "app.wckd.gpu",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "wckd-gpu",
        "width": 1120,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
