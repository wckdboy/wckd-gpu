# Coolify / compose. Never put provider keys here.
# docker-compose.yaml interpolates these. Neither is injected into the
# running nginx process. See docs/DEPLOY-COOLIFY.md.
#
# Public build-time flag. Empty unless you set a public origin.
VITE_PUBLIC_BASE_URL=

# Container port the Coolify proxy forwards to. nginx listens on 80.
# Optional. Leave 80. Runtime / proxy, not a secret.
PORT=80

# Copy to .env and fill in. .env is gitignored.
# The CLI loads ./.env without overriding variables that are already set.
#   set -a; source .env; set +a
# also works if you prefer the shell to export them.
#
# Local CLI only. Never set these on the Coolify resource.

# RunPod → Settings → API Keys. Never commit a real key.
RUNPOD_API_KEY=
WCKD_RUNPOD_BASE_URL=https://api.runpod.io

# Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
# Any other S3-compatible endpoint works the same way.
WCKD_S3_ENDPOINT=
WCKD_S3_BUCKET=
WCKD_S3_ACCESS_KEY=
WCKD_S3_SECRET_KEY=
WCKD_S3_REGION=auto
WCKD_S3_PATH_STYLE=true

WCKD_SESSION_HOURS=1
WCKD_PROJECT_ID=hailuo-tests
WCKD_PRESET_ID=comfyui-minimax-h3

# Optional image built from sidecar/Dockerfile. Overrides the preset image.
# WCKD_IMAGE=

# WCKD_STATE_DIR=
# WCKD_PRESETS_DIR=
# WCKD_CONFIG=
