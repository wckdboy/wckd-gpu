{
  "name": "wckd-gpu",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @wckd/web dev",
    "build": "pnpm --filter @wckd/web build",
    "test": "pnpm --filter @wckd/web test",
    "lint": "pnpm --filter @wckd/web lint",
    "desktop:check": "pnpm --filter @wckd/web build && pnpm --filter @wckd/desktop check"
  },
  "packageManager": "pnpm@10.33.3",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "@tauri-apps/cli"]
  }
}
